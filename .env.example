# stream-proxy configuration
# Copy to .env and adjust

# Port for stream-proxy HTTP server
PROXY_PORT=9190

# Base URL of local anivexa-api instance
ANIVEXA_BASE=http://localhost:9189

# HMAC secret for play tokens (generate with: openssl rand -hex 32)
HMAC_SECRET=change_me_in_production

# CORS settings
CORS_ALLOWED_ORIGINS=*
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upstream timeouts (seconds)
UPSTREAM_DIAL_TIMEOUT=10
UPSTREAM_RESPONSE_TIMEOUT=15
UPSTREAM_IDLE_TIMEOUT=30
UPSTREAM_PLAYLIST_TIMEOUT=30

# Cache TTLs (seconds)
CACHE_MASTER_TTL=60
CACHE_VARIANT_TTL=15
CACHE_MEDIA_TTL=15
CACHE_MPD_TTL=30
CACHE_EMBED_TTL=60
CACHE_NEGATIVE_TTL=10

# Size limits
MAX_PLAYLIST_SIZE=2097152
MAX_MPD_SIZE=1048576
MAX_EMBED_SIZE=4194304

# Concurrency limits
MAX_GLOBAL_CONCURRENT=64
MAX_PER_HOST_CONCURRENT=8

# Logging
LOG_LEVEL=info